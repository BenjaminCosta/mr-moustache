# Replace these placeholders before launch.
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SQUARE_BOOKING_URL=https://mr-moustache-barbershop.square.site/
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/mr.moustache.barbers/
NEXT_PUBLIC_GOOGLE_PROFILE_URL=https://www.google.com/maps/search/?api=1&query=Mr+Moustache+Broadbeach

# Per-shop Square Appointments pages (defaults live in src/lib/constants.ts).
NEXT_PUBLIC_SQUARE_BOOKING_URL_SURFERS_PARADISE=https://book.squareup.com/appointments/o0xkg1fz5zxow7/location/LA3KEKYDA4KV3
NEXT_PUBLIC_SQUARE_BOOKING_URL_BROADBEACH=https://book.squareup.com/appointments/o0xkg1fz5zxow7/location/LS4XGMYEDQ5ER

# Work With Us form: FormSubmit inbox or its random alias after activation.
NEXT_PUBLIC_FORMSUBMIT_TARGET=mr.moustache.barbers@gmail.com

# Square OAuth and Bookings API (server-only). See docs/AUTOMATION.md.
# Generate secrets with `openssl rand -base64 32` (CRON_SECRET: `openssl rand -hex 32`).
SQUARE_ENVIRONMENT=production
SQUARE_API_VERSION=2026-09-16
SQUARE_APPLICATION_ID=sq0idp-G6mu7_lz8zL09H36QAnmhA
SQUARE_APPLICATION_SECRET=
SQUARE_OAUTH_REDIRECT_URL=https://mr-moustache.vercel.app/api/square/oauth/callback
SQUARE_CONNECT_SECRET=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=https://mr-moustache.vercel.app/api/square/webhook
SQUARE_TOKEN_ENCRYPTION_KEY=

# Firebase Admin service account (server-only).
FIREBASE_PROJECT_ID=mr-moustache-automation
FIREBASE_CLIENT_EMAIL=mr-moustache-vercel@mr-moustache-automation.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=

# Location mapping. Copy these IDs from the connected Square seller account.
SQUARE_LOCATION_ID_SURFERS_PARADISE=
SQUARE_LOCATION_ID_BROADBEACH=
GOOGLE_REVIEW_URL_SURFERS_PARADISE=
GOOGLE_REVIEW_URL_BROADBEACH=

# Customer email automation. Keep both disabled until the sender domain,
# location links, and the business's consent process have been verified.
RESEND_API_KEY=
REVIEW_AUTOMATION_ENABLED=false
REBOOKING_AUTOMATION_ENABLED=false
REVIEW_DELAY_HOURS=24
REBOOKING_DELAY_DAYS=28
CUSTOMER_EMAIL_FROM=Mr Moustache <onboarding@resend.dev>
CUSTOMER_EMAIL_REPLY_TO=
MARKETING_UNSUBSCRIBE_SECRET=

# Vercel invokes the daily route with this secret as a Bearer token.
CRON_SECRET=
